node_modules/

# Local deploy cache for the project site. Regenerated on every
# `firebase deploy`, and only meaningful on the machine that wrote it.
.firebase/

# Never commit credentials. The real ones live in ~/.google-calendar-sync/,
# but guard against copies being dropped into the repo during debugging.
client.json
tokens.json
config.json
last-run.json
service-account.json
*-service-account.json
# Google Cloud hands you the OAuth client as client_secret_<id>.json, which
# lands in whatever directory the browser downloads to.
client_secret*.json
*.pem
*.p12
.env
